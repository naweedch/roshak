// شمای پایگاه دادهٔ فروشگاه روشنک
// قواعد کلی:
// - شناسه‌های عمومی UUIDv7 هستند (ترتیب زمانی، غیرقابل حدس).
// - همهٔ زمان‌ها timestamptz و به وقت UTC ذخیره می‌شوند.
// - مبالغ پولی numeric(16,2) هستند و ارز هر مبلغ صریحاً کنار آن ثبت می‌شود.
// - قیدهای CHECK و ایندکس‌های جزئی که Prisma پشتیبانی نمی‌کند در فایل‌های migration نوشته شده‌اند.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── کاربران و احراز هویت ───────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SessionKind {
  CUSTOMER
  STAFF
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  marketingOptIn  Boolean    @default(false)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  authTokens         AuthToken[]
  addresses          Address[]
  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
  reviews            Review[]                 @relation("ReviewAuthor")
  moderatedReviews   Review[]                 @relation("ReviewModerator")
  notesAboutMe       CustomerNote[]           @relation("NoteCustomer")
  notesWritten       CustomerNote[]           @relation("NoteAuthor")
  auditLogs          AdminAuditLog[]
  inventoryMovements InventoryMovement[]
  refundsCreated     Refund[]
  shipmentsCreated   Shipment[]
  orderEvents        OrderEvent[]
  discountRedemptions DiscountRedemption[]
  mediaUploads       MediaAsset[]
  articles           Article[]
  settingsUpdates    StoreSettings[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  // شناسه = هش HMAC توکن کوکی؛ خود توکن هرگز ذخیره نمی‌شود
  id         String      @id
  userId     String      @db.Uuid
  kind       SessionKind
  expiresAt  DateTime    @db.Timestamptz(3)
  lastSeenAt DateTime    @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @db.Uuid
  label         String?
  recipientName String
  phone         String
  province      String
  city          String
  addressLine   String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  customer User  @relation("NoteCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  author   User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([authorId])
}

// ─────────────────────────── کاتالوگ ───────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DressLength {
  MINI
  KNEE
  MIDI
  MAXI
  FLOOR
}

enum CollectionType {
  CURATED
  SEASON
  OCCASION
  CAMPAIGN
}

enum ColorFamily {
  RED
  PINK
  PURPLE
  BLUE
  GREEN
  GOLD
  NEUTRAL
  BLACK
  WHITE
  SILVER
}

enum ImageKind {
  GALLERY
  VIEW360
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  slug           String   @unique
  name           String
  description    String?
  coverImageUrl  String?
  coverImageAlt  String?
  sortOrder      Int      @default(0)
  isVisible      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([isVisible, sortOrder])
}

model Collection {
  id             String         @id @default(uuid(7)) @db.Uuid
  slug           String         @unique
  name           String
  subtitle       String?
  description    String?
  type           CollectionType @default(CURATED)
  coverImageUrl  String?
  coverImageAlt  String?
  // کلید یکی از رنگ‌های طراحی (burgundy, emerald, ...) برای هویت بصری مجموعه
  accentColor    String?
  isVisible      Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  sortOrder      Int            @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  products  ProductCollection[]
  discounts DiscountCollection[]
  redirects CollectionSlugRedirect[]

  @@index([isVisible, sortOrder])
  @@index([type, isVisible])
}

model Color {
  id        String      @id @default(uuid(7)) @db.Uuid
  slug      String      @unique
  name      String
  hex       String
  family    ColorFamily
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  variants ProductVariant[]
  images   ProductImage[]
}

model Size {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  variants ProductVariant[]
}

model SizeGuide {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  // جدول اندازه‌ها: آرایه‌ای از سطرها با ستون‌های ثابت (اعتبارسنجی با Zod در لایهٔ سرویس)
  rows        Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  products Product[]
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  slug             String        @unique
  name             String
  subtitle         String?
  description      String
  fabric           String?
  careInstructions String?
  modelInfo        String?
  status           ProductStatus @default(DRAFT)
  categoryId       String        @db.Uuid
  sizeGuideId      String?       @db.Uuid
  length           DressLength?
  currency         String        @db.VarChar(3)
  price            Decimal       @db.Decimal(16, 2)
  salePrice        Decimal?      @db.Decimal(16, 2)
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  publishedAt      DateTime?     @db.Timestamptz(3)
  salesCount       Int           @default(0)
  ratingAverage    Decimal?      @db.Decimal(3, 2)
  reviewCount      Int           @default(0)
  model3dUrl       String?
  seoTitle         String?
  seoDescription   String?
  // متن نرمال‌شده برای جست‌وجوی تمام‌متن؛ توسط سرویس محصول به‌روزرسانی می‌شود
  searchText       String        @default("")
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  category      Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeGuide     SizeGuide?               @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  images        ProductImage[]
  collections   ProductCollection[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  discounts     DiscountProduct[]
  redirects     ProductSlugRedirect[]

  @@index([status, publishedAt])
  @@index([status, isFeatured])
  @@index([status, salesCount])
  @@index([status, sortOrder])
  @@index([categoryId])
  @@index([sizeGuideId])
}

model ProductSlugRedirect {
  id        String   @id @default(uuid(7)) @db.Uuid
  fromSlug  String   @unique
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CollectionSlugRedirect {
  id           String   @id @default(uuid(7)) @db.Uuid
  fromSlug     String   @unique
  collectionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

model ProductCollection {
  productId    String @db.Uuid
  collectionId String @db.Uuid
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model ProductVariant {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @db.Uuid
  sku               String   @unique
  colorId           String   @db.Uuid
  sizeId            String   @db.Uuid
  stock             Int      @default(0)
  lowStockThreshold Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  color              Color               @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size               Size                @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, colorId, sizeId])
  @@index([colorId])
  @@index([sizeId])
}

model ProductImage {
  id         String    @id @default(uuid(7)) @db.Uuid
  productId  String    @db.Uuid
  url        String
  storageKey String?
  alt        String
  width      Int
  height     Int
  colorId    String?   @db.Uuid
  kind       ImageKind @default(GALLERY)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([colorId])
}

model MediaAsset {
  id           String   @id @default(uuid(7)) @db.Uuid
  storageKey   String   @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  alt          String?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([uploadedById])
}

// ─────────────────────────── انبار ───────────────────────────

enum InventoryReason {
  INITIAL
  ADJUSTMENT
  RESTOCK
  SALE
  ORDER_CANCELLED
  PAYMENT_FAILED
  RESERVATION_EXPIRED
  RETURN
  CORRECTION
}

model InventoryMovement {
  id         String          @id @default(uuid(7)) @db.Uuid
  variantId  String          @db.Uuid
  delta      Int
  stockAfter Int
  reason     InventoryReason
  orderId    String?         @db.Uuid
  actorId    String?         @db.Uuid
  note       String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────── سبد خرید و علاقه‌مندی ───────────────────────────

model Cart {
  id           String   @id @default(uuid(7)) @db.Uuid
  // سبد مهمان با هش توکن کوکی شناسایی می‌شود؛ سبد کاربر با userId
  tokenHash    String?  @unique
  userId       String?  @unique @db.Uuid
  discountCode String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

// ─────────────────────────── سفارش، پرداخت، ارسال ───────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum CancelReason {
  CUSTOMER_REQUEST
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  OUT_OF_STOCK
  FRAUD_SUSPECTED
  ADMIN_DECISION
}

enum PaymentProvider {
  TEST
  ZARINPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SHIPMENT_UPDATED
  REFUND_RECORDED
  NOTE
}

model ShippingMethod {
  id                   String   @id @default(uuid(7)) @db.Uuid
  code                 String   @unique
  name                 String
  description          String?
  currency             String   @db.VarChar(3)
  price                Decimal  @db.Decimal(16, 2)
  minDays              Int?
  maxDays              Int?
  freeShippingEligible Boolean  @default(true)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  @@index([isActive, sortOrder])
}

model Order {
  id                   String             @id @default(uuid(7)) @db.Uuid
  orderNumber          String             @unique
  userId               String?            @db.Uuid
  email                String
  phone                String
  customerName         String
  status               OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus        OrderPaymentStatus @default(UNPAID)
  currency             String             @db.VarChar(3)
  subtotal             Decimal            @db.Decimal(16, 2)
  discountTotal        Decimal            @default(0) @db.Decimal(16, 2)
  shippingTotal        Decimal            @db.Decimal(16, 2)
  taxTotal             Decimal            @db.Decimal(16, 2)
  grandTotal           Decimal            @db.Decimal(16, 2)
  refundedTotal        Decimal            @default(0) @db.Decimal(16, 2)
  taxRate              Decimal            @db.Decimal(5, 2)
  pricesIncludeTax     Boolean
  discountCode         String?
  shippingMethodId     String?            @db.Uuid
  shippingMethodName   String
  shipRecipientName    String
  shipPhone            String
  shipProvince         String
  shipCity             String
  shipAddressLine      String
  shipPostalCode       String
  customerNote         String?
  idempotencyKey       String             @unique
  accessTokenHash      String
  reservationExpiresAt DateTime?          @db.Timestamptz(3)
  placedAt             DateTime           @default(now()) @db.Timestamptz(3)
  paidAt               DateTime?          @db.Timestamptz(3)
  cancelledAt          DateTime?          @db.Timestamptz(3)
  cancelReason         CancelReason?
  cancelNote           String?
  shippedAt            DateTime?          @db.Timestamptz(3)
  deliveredAt          DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod     ShippingMethod?     @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  shipments          Shipment[]
  events             OrderEvent[]
  inventoryMovements InventoryMovement[]
  discountRedemption DiscountRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([email])
  @@index([createdAt])
  @@index([status, reservationExpiresAt])
  @@index([shippingMethodId])
}

model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @db.Uuid
  productId      String?  @db.Uuid
  variantId      String?  @db.Uuid
  // اطلاعات لحظهٔ خرید؛ با ویرایش محصول تغییر نمی‌کنند
  productName    String
  productSlug    String
  sku            String
  colorName      String
  sizeLabel      String
  imageUrl       String?
  unitPrice      Decimal  @db.Decimal(16, 2)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(16, 2)
  discountAmount Decimal  @default(0) @db.Decimal(16, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  orderId    String         @db.Uuid
  type       OrderEventType
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  message    String?
  // آیا برای مشتری در صفحهٔ پیگیری نمایش داده شود
  isPublic   Boolean        @default(true)
  actorId    String?        @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId])
}

model Payment {
  id                    String          @id @default(uuid(7)) @db.Uuid
  orderId               String          @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  currency              String          @db.VarChar(3)
  amount                Decimal         @db.Decimal(16, 2)
  // شناسهٔ تراکنش نزد درگاه (مثلاً Authority زرین‌پال)
  providerReference     String?
  // شمارهٔ پیگیری نهایی پس از تأیید درگاه
  providerTransactionId String?
  // فقط شمارهٔ کارت ماسک‌شده؛ اطلاعات خام کارت هرگز ذخیره نمی‌شود
  cardPanMasked         String?
  failureReason         String?
  verifiedAt            DateTime?       @db.Timestamptz(3)
  expiresAt             DateTime        @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, createdAt])
}

// وضعیت تراکنش‌های «درگاه آزمایشی». این جدول نقش پایگاه دادهٔ درگاه را بازی می‌کند
// تا تأیید پرداخت در حالت آزمایشی هم از سمت سرور و مستقل از پارامترهای URL انجام شود.
model TestGatewayTransaction {
  id        String        @id @default(uuid(7)) @db.Uuid
  reference String        @unique
  amount    Decimal       @db.Decimal(16, 2)
  currency  String        @db.VarChar(3)
  status    PaymentStatus @default(PENDING)
  decidedAt DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
}

model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  orderId        String       @db.Uuid
  paymentId      String?      @db.Uuid
  currency       String       @db.VarChar(3)
  amount         Decimal      @db.Decimal(16, 2)
  reason         String
  method         String?
  reference      String?
  status         RefundStatus @default(COMPLETED)
  restocked      Boolean      @default(false)
  idempotencyKey String?      @unique
  createdById    String?      @db.Uuid
  completedAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([createdById])
}

model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @db.Uuid
  carrier        String
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PREPARING)
  shippedAt      DateTime?      @db.Timestamptz(3)
  deliveredAt    DateTime?      @db.Timestamptz(3)
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdById])
}

// ─────────────────────────── تخفیف ───────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  PRODUCTS
  COLLECTIONS
}

model Discount {
  id                String        @id @default(uuid(7)) @db.Uuid
  code              String        @unique
  description       String?
  type              DiscountType
  scope             DiscountScope @default(ALL)
  // درصد (۰ تا ۱۰۰) یا مبلغ ثابت به ارز currency
  value             Decimal       @default(0) @db.Decimal(16, 2)
  currency          String?       @db.VarChar(3)
  maxDiscountAmount Decimal?      @db.Decimal(16, 2)
  minOrderAmount    Decimal?      @db.Decimal(16, 2)
  startsAt          DateTime?     @db.Timestamptz(3)
  endsAt            DateTime?     @db.Timestamptz(3)
  usageLimit        Int?
  usageCount        Int           @default(0)
  perCustomerLimit  Int?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  products    DiscountProduct[]
  collections DiscountCollection[]
  redemptions DiscountRedemption[]

  @@index([isActive])
}

model DiscountProduct {
  discountId String @db.Uuid
  productId  String @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountCollection {
  discountId   String @db.Uuid
  collectionId String @db.Uuid

  discount   Discount   @relation(fields: [discountId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([discountId, collectionId])
  @@index([collectionId])
}

model DiscountRedemption {
  id         String   @id @default(uuid(7)) @db.Uuid
  discountId String   @db.Uuid
  orderId    String   @unique @db.Uuid
  userId     String?  @db.Uuid
  email      String
  amount     Decimal  @db.Decimal(16, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([discountId, email])
  @@index([discountId, userId])
  @@index([userId])
}

// ─────────────────────────── نظرات، خبرنامه، تماس ───────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(uuid(7)) @db.Uuid
  productId          String       @db.Uuid
  userId             String       @db.Uuid
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  // نمایش در بخش «گفته‌های مشتریان» صفحهٔ اصلی (فقط نظرات واقعی و تأییدشده)
  isFeatured         Boolean      @default(false)
  moderatedById      String?      @db.Uuid
  moderatedAt        DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User    @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId])
  @@index([moderatedById])
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscription {
  id                   String           @id @default(uuid(7)) @db.Uuid
  email                String           @unique
  status               NewsletterStatus @default(PENDING)
  confirmTokenHash     String?          @unique
  unsubscribeTokenHash String           @unique
  source               String?
  confirmedAt          DateTime?        @db.Timestamptz(3)
  unsubscribedAt       DateTime?        @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status])
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ─────────────────────────── محتوا ───────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerPlacement {
  HOME_HERO
  HOME_CAMPAIGN
  HOME_STORY
}

model Article {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique
  title          String
  excerpt        String
  body           String
  coverImageUrl  String?
  coverImageAlt  String?
  authorName     String
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?     @db.Timestamptz(3)
  readingMinutes Int?
  seoTitle       String?
  seoDescription String?
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([createdById])
}

model ContentPage {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique
  title          String
  summary        String?
  body           String
  status         PublishStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
}

model FaqItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  question  String
  answer    String
  group     String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isVisible, sortOrder])
}

model Banner {
  id                String          @id @default(uuid(7)) @db.Uuid
  placement         BannerPlacement
  eyebrow           String?
  title             String
  subtitle          String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  imageUrl          String?
  imageAlt          String?
  mobileImageUrl    String?
  /// ویدئوی اختیاری اسلاید (MP4/WebM فشرده)؛ imageUrl نقش پوستر و جایگزین آن را دارد
  videoUrl          String?
  accentColor       String?
  isActive          Boolean         @default(true)
  startsAt          DateTime?       @db.Timestamptz(3)
  endsAt            DateTime?       @db.Timestamptz(3)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@index([placement, isActive, sortOrder])
}

model Announcement {
  id        String    @id @default(uuid(7)) @db.Uuid
  message   String
  linkLabel String?
  href      String?
  isActive  Boolean   @default(true)
  startsAt  DateTime? @db.Timestamptz(3)
  endsAt    DateTime? @db.Timestamptz(3)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

// ─────────────────────────── تنظیمات، ممیزی، صف ایمیل ───────────────────────────

model StoreSettings {
  // جدول تک‌سطری (id همیشه ۱ است؛ با CHECK در migration تضمین می‌شود)
  id                     Int               @id @default(1)
  storeName              String
  storeNameEn            String
  tagline                String?
  currency               String            @db.VarChar(3)
  taxRate                Decimal           @default(0) @db.Decimal(5, 2)
  pricesIncludeTax       Boolean           @default(true)
  freeShippingThreshold  Decimal?          @db.Decimal(16, 2)
  lowStockThreshold      Int               @default(2)
  reservationMinutes     Int               @default(30)
  returnWindowDays       Int               @default(7)
  contactEmail           String?
  contactPhone           String?
  contactAddress         String?
  workingHours           String?
  instagramUrl           String?
  telegramUrl            String?
  whatsappUrl            String?
  pinterestUrl           String?
  newsletterEnabled      Boolean           @default(true)
  newsletterDoubleOptIn  Boolean           @default(true)
  enabledPaymentProviders PaymentProvider[]
  emailFromName          String?
  seoTitleTemplate       String            @default("%s | روشنک")
  seoDefaultTitle        String
  seoDefaultDescription  String
  ogImageUrl             String?
  googleSiteVerification String?
  analyticsEnabled       Boolean           @default(false)
  gaMeasurementId        String?
  updatedById            String?           @db.Uuid
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AdminAuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String
  action     String
  entityType String
  entityId   String?
  summary    String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String       @id @default(uuid(7)) @db.Uuid
  to        String
  subject   String
  template  String
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sendAfter DateTime     @default(now()) @db.Timestamptz(3)
  lockedAt  DateTime?    @db.Timestamptz(3)
  sentAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, sendAfter])
}

model SearchQueryLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  term        String
  resultCount Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([term])
}
