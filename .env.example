# ═══════════════════════════════════════════════════════════════
# نمونهٔ متغیرهای محیطی روشاک
# این فایل را به .env کپی کنید و مقادیر را پر کنید. هیچ رمز واقعی در این فایل نیست.
# توضیح کامل هر متغیر: docs/environment.md
# ═══════════════════════════════════════════════════════════════

# ─── عمومی ───
NODE_ENV=development
# نشانی عمومی سایت بدون اسلش انتهایی (در محیط عملیاتی حتماً https)
APP_URL=http://localhost:3100
LOG_LEVEL=info

# ─── پایگاه داده (PostgreSQL 16+) ───
DATABASE_URL=postgresql://roshnak:CHANGE_ME@localhost:5433/roshnak
DATABASE_POOL_MAX=10
# پایگاه دادهٔ جداگانه برای تست‌های یکپارچه (نامش باید شامل test باشد؛ محتوایش در هر اجرا پاک می‌شود)
TEST_DATABASE_URL=postgresql://roshnak:CHANGE_ME@localhost:5433/roshnak_test

# PostgreSQL محلی بدون Docker (npm run db:local) — فقط توسعه
LOCAL_PG_PORT=5433
LOCAL_PG_USER=roshnak
LOCAL_PG_PASSWORD=CHANGE_ME
# پیش‌فرض: ~/.roshnak/postgres
LOCAL_PG_DATA_DIR=

# ─── امنیت ───
# کلید HMAC برای هش توکن نشست‌ها و لینک‌ها (حداقل ۳۲ کاراکتر تصادفی):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_HASH_SECRET=
# کلید فراخوانی POST /api/v1/internal/jobs (هدر Authorization: Bearer ...)
CRON_SECRET=
# تعداد پروکسی‌های معکوس مورد اعتماد جلوی برنامه (nginx = 1، CDN + nginx = 2)
TRUSTED_PROXY_HOPS=0
# مبدأهای اضافهٔ مجاز برای درخواست‌های تغییر داده (با کاما جدا؛ معمولاً خالی)
ALLOWED_ORIGINS=

# ─── حساب مدیر توسعه (فقط npm run db:seed در محیط توسعه؛ در محیط عملیاتی از npm run admin:create استفاده کنید) ───
SEED_ADMIN_EMAIL=admin@roshak.local
# حداقل ۱۲ کاراکتر؛ خالی = حساب مدیر ساخته نمی‌شود
SEED_ADMIN_PASSWORD=
# فقط برای اجرای عمدی seed روی محیط عملیاتی (توصیه نمی‌شود)
SEED_ALLOW_PRODUCTION=

# ─── ایمیل ───
# log = ذخیره در .data/mail (توسعه) | smtp = ارسال واقعی
EMAIL_PROVIDER=log
EMAIL_FROM="روشاک <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# دریافت اعلان سفارش جدید برای فروشگاه
STORE_NOTIFICATION_EMAIL=

# ─── ذخیره‌سازی تصاویر ───
# local = پوشهٔ LOCAL_STORAGE_DIR | s3 = هر سرویس سازگار با S3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# نشانی عمومی فایل‌ها (مثلاً https://cdn.example.com) — در CSP و next/image هم استفاده می‌شود
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ─── پرداخت ───
# درگاه آزمایشی (بدون پول واقعی). در محیط عملیاتی فقط با ALLOW_TEST_PAYMENTS_IN_PRODUCTION=true فعال می‌شود — هرگز فعال نکنید.
PAYMENT_TEST_MODE=true
ALLOW_TEST_PAYMENTS_IN_PRODUCTION=false
PAYMENT_TEST_WEBHOOK_SECRET=
# زرین‌پال (پس از تنظیم، در پنل ← تنظیمات ← درگاه‌های پرداخت فعال شود)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ─── سرویس‌های اختیاری ───
# Redis برای محدودیت نرخ مشترک بین چند نمونهٔ برنامه
REDIS_URL=
# نمایش پست‌های اینستاگرام در صفحهٔ اصلی (Instagram Graph API)
INSTAGRAM_ACCESS_TOKEN=
# ارسال خطاهای سرور به یک endpoint (مثلاً وب‌هوک Slack یا سرویس مانیتورینگ)
ERROR_WEBHOOK_URL=
# اجازهٔ دامنه‌های Google Analytics در CSP هنگام build (شناسه را در پنل ← تنظیمات هم وارد کنید)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── کارهای دوره‌ای (npm run jobs:run -- --loop) ───
JOBS_INTERVAL_SECONDS=300

# ─── تست‌های سرتاسری (Playwright) — فقط توسعه ───
E2E_BASE_URL=http://localhost:3100
# حساب کارمند با نقش ORDER_MANAGER (با npm run admin:create -- --role ORDER_MANAGER بسازید)
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
# مرورگر محلی: chrome | msedge (در CI مرورگر داخلی Playwright استفاده می‌شود)
E2E_BROWSER_CHANNEL=chrome
